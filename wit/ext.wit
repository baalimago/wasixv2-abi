/// Wasm-specific primitives with no Linux syscall equivalent.
///
/// Keep this small: anything Linux can express stays in `syscalls`. Functions marked TENTATIVE
/// are placeholders whose shape is not settled; hosts may return `-ENOSYS` for them.
/// @module(wasixv2)
interface ext {
  use types.{buf, cstr, dl-flags, dl-handle, dl-handle-ptr, s32-ptr, u32-ptr, u64-ptr, ulong, uptr, uptr-ptr, slong, usize};

  // ==== Process startup ====

  /// Size in bytes of the startup block that `startup-get` writes.
  startup-size: func() -> u32;

  /// Writes the Linux-style initial process block into `buf`, which holds `len` bytes and must be
  /// 16-byte aligned. Returns 0, or `-EINVAL` when `len` is less than `startup-size()`.
  ///
  /// The layout matches what the kernel puts on the initial stack, with every pointer being a
  /// guest address inside `buf` and every word `ulong`-sized:
  ///
  /// - `argc`
  /// - `argv[0]` .. `argv[argc - 1]`, then NULL
  /// - `envp[0]` .. `envp[n - 1]`, then NULL
  /// - auxv `(type, value)` pairs (see `auxv-type`), terminated by `(AT_NULL, 0)`
  /// - string data and other auxv payloads (`AT_RANDOM`'s 16 bytes, `AT_EXECFN`, ...)
  ///
  /// Hosts provide at least `AT_PAGESZ`, `AT_RANDOM`, `AT_UID`, `AT_EUID`, `AT_GID`, `AT_EGID`,
  /// `AT_SECURE` and `AT_CLKTCK`. ELF-related entries (`AT_PHDR`, `AT_ENTRY`, ...) are absent.
  /// @slice(buf, len)
  startup-get: func(buf: buf, len: usize) -> s32;

  // ==== Threads ====

  /// Starts a new thread: `clone` for the thread case, which cannot return twice in wasm.
  ///
  /// The kernel validates `flags` and creates the task as `clone(flags, newsp, parent-tid, tls,
  /// child-tid)` does on Linux, so `CLONE_PARENT_SETTID`, `CLONE_CHILD_SETTID`,
  /// `CLONE_CHILD_CLEARTID` and the sharing flags mean the same. `flags` must contain `CLONE_VM`,
  /// `CLONE_FS`, `CLONE_FILES`, `CLONE_SIGHAND` and `CLONE_THREAD`; other forms are `-EINVAL`, and
  /// forks go through `clone`. `CLONE_SETTLS` records `tls` as the thread pointer the new thread
  /// starts with.
  ///
  /// The host then instantiates the module again on the same shared memory and calls its export
  /// `wasixv2_thread_start(tid: s32, start-arg: uptr)` in the new thread. That entry point runs
  /// before any guest state is set up: it must point `__stack_pointer` at the new thread's stack
  /// and set up TLS before it touches either, all from what `start-arg` points to, which the
  /// guest defines. The thread ends when it calls `exit` or `exit_group`; the entry point must
  /// not return. A thread that returns from it or traps ends its thread group, as a fault does.
  /// Returns the new thread id or `-errno`.
  thread-spawn: func(%flags: ulong, start-arg: uptr, parent-tid: s32-ptr, tls: uptr, child-tid: s32-ptr) -> slong;

  // ==== Signals ====

  /// Registers libc's signal trampoline for the thread group, as an index into the module's
  /// indirect function table, with the signature `fn(signo: s32, info: siginfo-ptr, uctx: void-ptr)`.
  /// Threads and `fork` children inherit it; `execve` clears it. Until it is registered, signals
  /// take their default action even when a handler is installed.
  ///
  /// To deliver a signal, the host writes a `ucontext_t` (816 bytes, 16-aligned) and above it the
  /// `siginfo_t` (128 bytes) below the module's `__stack_pointer`, or at the top of the alternate
  /// stack set with `sigaltstack` for an `SA_ONSTACK` handler, points `__stack_pointer` below the
  /// frame, and calls the trampoline on top of the interrupted wasm call stack, which stays intact.
  /// The `ucontext_t` has libc's riscv32-shaped layout: `uc_stack` at 8 holds the alternate stack
  /// settings, `uc_sigmask` at 20 the mask to restore, and `uc_mcontext` at 160 starts with four
  /// `ulong` slots: the handler (`sa_handler`, a table index), `sa_flags`, and the interrupted
  /// `__stack_pointer` and `__tls_base`. The trampoline calls the handler with one argument, or
  /// with three when `SA_SIGINFO` is set, and returns. That return is `rt_sigreturn`: the host
  /// then sets the signal mask from `uc_sigmask` and the two globals from the `mcontext` slots.
  /// A `siglongjmp` out of the handler unwinds through the host frames as a wasm exception, and
  /// leaves the mask to `siglongjmp`.
  /// Returns 0 or `-errno`.
  signal-callback-register: func(callback: u32) -> slong;

  // ==== Coroutines ====

  /// TENTATIVE. Creates a suspended coroutine context and writes its id to `id`. Its first
  /// resumption calls the function at table index `entry` (`fn()`) on a fresh wasm call stack; the
  /// guest provides the shadow stack. Carried over from wasixv1 (wasix-libc's `wasix/context.h`):
  /// greenlet uses it directly, and libc builds `makecontext` and `swapcontext` on top of it.
  /// Returns 0 or `-errno`.
  /// @unsupported
  context-create: func(entry: u32, id: u64-ptr) -> slong;

  /// TENTATIVE. Suspends the current context and resumes context `id`, from where it last
  /// suspended or from its entry point. Returns 0 once another context switches back to this one,
  /// or `-errno`.
  /// @unsupported
  context-switch: func(id: u64) -> slong;

  /// TENTATIVE. Destroys a suspended or finished context and releases its resources. Destroying
  /// the current or the main context fails. Returns 0 or `-errno`.
  /// @unsupported
  context-destroy: func(id: u64) -> slong;

  // ==== Dynamic linking ====
  //
  // The host instantiates and links side modules; libc2 decides policy and runs constructors.
  // See "Dynamic linking" in wasmer's lib/wasixv2/DESIGN.md. Side modules must export
  // `__wasm_init_tls`, `__tls_size` and `__tls_align`. During a link the host calls only
  // functions wasm-ld synthesizes, never user code.

  /// TENTATIVE. `dlopen`: loads `file` and the modules it needs into every instance of the
  /// process, unless they are loaded already, links them, and writes the handle of `file`'s
  /// module to `handle`.
  ///
  /// `file` NULL is the main program. A `file` containing `/` is opened as is, relative to the
  /// working directory; otherwise each directory of `search-path` is tried in order.
  ///
  /// `search-path` is a colon-separated list, or NULL for none: libc passes `LD_LIBRARY_PATH` as
  /// read at startup, then the default directories. A needed module is searched in the needing
  /// module's runtime path, then in `search-path`. Every candidate is opened as `openat` would,
  /// with the process's credentials and working directory.
  ///
  /// `flags` are `RTLD_*`, with musl's meaning. Symbols are bound at load time either way. With
  /// `RTLD_LAZY`, a function or GOT reference to a missing symbol does not fail the load: it is
  /// resolved when a later `RTLD_GLOBAL` load defines the symbol, and calling a function that
  /// never appears kills the process. With `RTLD_NOW`, a missing symbol fails the load.
  /// `caller-addr` is an address in the calling module's data, such as its `__dso_handle`, or 0
  /// for the main module. It selects the module whose runtime path applies.
  ///
  /// Constructors are not run: newly loaded modules are queued, in initialization order, for
  /// `dl-next-init`. On failure, writes a NUL-terminated message for `dlerror` into `err`.
  /// Returns 0 or `-errno`.
  /// @slice(err, err-len)
  /// @unsupported
  dl-open: func(
    file: cstr,
    %flags: dl-flags,
    search-path: cstr,
    caller-addr: uptr,
    handle: dl-handle-ptr,
    err: buf,
    err-len: usize,
  ) -> slong;

  /// TENTATIVE. `dlsym`: looks up `symbol` and writes its address to `addr`: a linear memory
  /// address for data, or a function-table index for a function, which is placed in the table of
  /// every instance if it is not there yet.
  ///
  /// `handle` is a module, searched with its dependencies; `RTLD_DEFAULT`, the global scope; or
  /// `RTLD_NEXT`, the global scope after the caller's module. `caller-addr` is as for
  /// `dl-open`. Symbol precedence and weak symbols follow ELF rules. On failure, writes a
  /// NUL-terminated message for `dlerror` into `err`. Returns 0 or `-errno`.
  /// @slice(err, err-len)
  /// @unsupported
  dl-sym: func(
    handle: dl-handle,
    symbol: cstr,
    caller-addr: uptr,
    addr: uptr-ptr,
    err: buf,
    err-len: usize,
  ) -> slong;

  /// TENTATIVE. `dlclose`: drops a reference to `handle`. Code is never unloaded. Returns 0, or
  /// `-EINVAL` if `handle` is not a loaded module.
  /// @unsupported
  dl-close: func(handle: dl-handle) -> slong;

  /// TENTATIVE. Takes the next queued module whose constructors have not run, in initialization
  /// order, and writes the function-table index of its `__wasm_call_ctors` to `ctors`, or 0 if it
  /// has none. Returns 1 when it took a module, 0 when the queue is empty, or `-errno`.
  ///
  /// libc calls this until the queue is empty after every successful `dl-open`, and before
  /// `main` for the libraries loaded at startup, then calls each `ctors` function. No host lock is
  /// held then, so constructors may call `dlopen`; libc serializes loading with its own lock.
  /// @unsupported
  dl-next-init: func(ctors: uptr-ptr) -> slong;
}
